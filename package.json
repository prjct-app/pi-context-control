{
  "name": "@prjct.app/pi-context-control",
  "version": "0.1.4",
  "description": "Agent-owned context inspection, history recovery and native Pi compaction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-context-control.git"
  },
  "homepage": "https://github.com/prjct-app/pi-context-control#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-context-control/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-context-control/main/docs/cover.png"
  },
  "files": [
    "index.js",
    "src",
    "README.md",
    "LICENSE",
    "docs/cover.png"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "check": "node --check index.js && node --check src/history.js && node --check src/controller.js && node --check src/views.js",
    "test": "export PI_CODING_AGENT_DIR=\"$(mktemp -d)\" PRJCT_HOME=\"$(mktemp -d)\" && node --test tests/*.test.js",
    "check:package": "npm pack --dry-run --ignore-scripts"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context",
    "compaction",
    "pi"
  ]
}
